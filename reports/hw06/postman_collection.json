{
  "info": {
    "name": "DATA260 HW6 s9275 - Recall Notice Documents (MongoDB)",
    "description": "Run folders top to bottom. Folder 4 deletes the notice created in folder 1, so the collection can be re-run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "notice_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 CRUD success",
      "item": [
        {
          "name": "1.1 Create notice (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8275/api/doc/notices"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_name\": \"Peanut Butter Cookies 8 oz\",\n  \"reason\": \"Undeclared tree nuts (almonds).\",\n  \"recall_number\": \"F-0901-2026\",\n  \"category\": \"Undeclared Allergen\",\n  \"recall_date\": \"2026-10-18T09:30:00Z\",\n  \"firm\": {\n    \"name\": \"Golden Oven Bakery\",\n    \"state\": \"CA\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json(); pm.collectionVariables.set('notice_id', j.id);",
                  "pm.test('status defaulted to ongoing', () => pm.expect(j.status).to.eql('ongoing'));",
                  "pm.test('timestamps set', () => pm.expect(j.created_at).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Get all notices (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8275/api/doc/notices"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('count >= 6', () => pm.expect(pm.response.json().count).to.be.at.least(6));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Get one notice (GET /:id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8275/api/doc/notices/{{notice_id}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Update notice (PUT /:id)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8275/api/doc/notices/{{notice_id}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_name\": \"Peanut Butter Cookies 8 oz\",\n  \"reason\": \"Undeclared tree nuts; all affected lots removed from shelves.\",\n  \"recall_number\": \"F-0901-2026\",\n  \"category\": \"Undeclared Allergen\",\n  \"recall_date\": \"2026-10-18T09:30:00Z\",\n  \"firm\": {\n    \"name\": \"Golden Oven Bakery\",\n    \"state\": \"CA\"\n  },\n  \"status\": \"completed\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('status now completed', () => pm.expect(j.status).to.eql('completed'));",
                  "pm.test('updated_at changed', () => pm.expect(j.updated_at).to.not.eql(j.created_at));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Filter by status (GET ?status=completed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8275/api/doc/notices?status=completed"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
