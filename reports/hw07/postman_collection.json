  "item": [
    {
      "name": "Login reader (200 + token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8275/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8275",
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"s9275_reader\",\n  \"password\": \"reader-9275\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('reader_token', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
